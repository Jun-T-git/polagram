{
  "name": "polagram",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "gen:docs": "pnpm run --filter @polagram/core gen:config-ref"
  },
  "homepage": "https://polagram.org/",
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.0.3",
    "turbo": "^2.7.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.16",
    "zod-to-json-schema": "^3.25.1"
  },
  "packageManager": "pnpm@8.15.1",
  "pnpm": {
    "overrides": {
      "mermaid@10.9.8>dompurify": "3.4.17"
    },
    "packageExtensions": {
      "lucide-react@0.300.0": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "react-resizable-panels@2.0.19": {
        "peerDependencies": {
          "@types/react": "*"
        },
